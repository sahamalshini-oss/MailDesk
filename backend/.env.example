# Security
JWT_SECRET=change-me
ENC_KEY=change-me-too

# App
BASE_URL=http://localhost:3000
# Comma-separated additional allowed CORS origins (BASE_URL is always trusted)
CORS_ORIGINS=

# Database (SQLite file path)
# DB_PATH=./data.db
# Set in production to authenticate/encrypt the database (requires SQLCipher-compatible driver)
# DB_KEY=change-me-strong-db-key 

# Database backups (protected, non-web-accessible directory)
# BACKUP_DIR=./backups
# Backup interval in ms (default: 1 hour)
# BACKUP_INTERVAL_MS=3600000
# Max number of backups to keep (default: 24)
# KEEP_BACKUPS=24

# Microsoft OAuth (Outlook)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
